FROM python:3.12-slim
WORKDIR /app
COPY requirements-status-maintenance.txt /app/
RUN pip install --no-cache-dir -r requirements-status-maintenance.txt
COPY close_status*.py /app/
COPY close_status_held_leads.json close_status_deferred_leads.json /app/
ENV PYTHONUNBUFFERED=1 CLOSE_STATUS_DATA_DIR=/data
CMD ["python", "close_status_cycle.py"]
